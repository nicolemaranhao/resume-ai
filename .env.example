# Copie este arquivo para ".env" e preencha. O .env NUNCA deve ir para o GitHub.
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelos tentados em ordem (o primeiro que responder é usado)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Legendas do YouTube: todas | manual | nao
# Quando o vídeo tem legenda, ela é usada no lugar do Whisper (muito mais rápido).
# "todas" usa legenda do autor e, se não houver, a automática no idioma original.
USAR_LEGENDAS=todas

# tiny | base | small | medium | turbo  (maior = mais preciso e mais lento)
WHISPER_MODEL=base

# Limite de duração e aviso de vídeo longo (minutos)
MAX_DURACAO_MIN=120
AVISO_LONGO_MIN=20
